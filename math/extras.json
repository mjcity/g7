{
  "lessons": [
    {
      "title": "Equivalent ratios",
      "rule": "Multiply or divide both parts of a ratio by the SAME nonzero number.",
      "equation": "3/5 = 12/20",
      "example": "3 × 4 = 12 and 5 × 4 = 20. Both parts grew by 4.",
      "tip": "Adding the same number to both parts usually does not keep the ratio equivalent."
    },
    {
      "title": "Cross products",
      "rule": "For a/b = c/d, compare a × d with b × c. Equal cross products mean equal ratios (denominators cannot be zero).",
      "equation": "2/3 = 8/12 because 2 × 12 = 3 × 8",
      "example": "24 = 24, so the statement is true.",
      "tip": "Cross-multiply diagonally, not straight across."
    },
    {
      "title": "Missing values",
      "rule": "Keep the same units in the same positions. Cross-multiply, then undo multiplication by dividing.",
      "equation": "x/10 = 3/5 → 5x = 30 → x = 6",
      "example": "Check: 6/10 simplifies to 3/5.",
      "tip": "The cross product is an intermediate step, not automatically the missing value."
    },
    {
      "title": "Unit rates",
      "rule": "Divide to find how much for ONE. Label the answer with its units.",
      "equation": "A 4 lb bag costs $10 → 10 ÷ 4 = $2.50/lb",
      "example": "For best value, compare the cost of the same unit.",
      "tip": "Round money at the end. A lower total price is not always a lower unit price."
    },
    {
      "title": "Percent proportions",
      "rule": "Percent means out of 100. Use part/whole = percent/100. Decide which quantity is missing.",
      "equation": "18/x = 30/100 → 30x = 1,800 → x = 60",
      "example": "18 is 30% of 60. Check: 0.30 × 60 = 18.",
      "tip": "When the whole is missing, divide the part by the decimal percent."
    },
    {
      "title": "Percent changes",
      "rule": "A discount leaves 100% minus the discount. A fee on the reduced price uses that NEW price.",
      "equation": "$100 with 20% off then a 10% fee → 100 × 0.80 × 1.10 = $88",
      "example": "The final price is $12 below $100, a 12% reduction.",
      "tip": "Successive percent changes usually cannot be combined by subtraction."
    }
  ],
